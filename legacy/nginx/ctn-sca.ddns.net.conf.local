# Minimal temporary vhost for initial certificate issuance.
# Add this as an extra file in /etc/nginx/conf.d/ so existing apps stay untouched.
# Deploy on server:
#   sudo cp nginx/ctn-sca.ddns.net.conf.local /etc/nginx/conf.d/ctn-sca.ddns.net.conf
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name ctn-sca.ddns.net;

    location /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
